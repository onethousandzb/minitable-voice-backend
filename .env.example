# ── 环境变量模板 ──
# 复制成 .env 本地用,或在部署平台的环境变量设置里填这些值。
# 真实的 .env 不要提交到 GitHub(已在 .gitignore 里排除)。

# Minitable 真实 API 域名(正式环境),结尾不带斜杠
MINITABLE_API_BASE=https://ai.minitable.net

# Minitable Basic Auth 账号密码(向 Minitable 获取,保密)
MINITABLE_USER=your_user
MINITABLE_PASS=your_password

# 可选:source 标记(默认 pbx)
# MINITABLE_SOURCE=pbx

# 可选:本中间层对 ElevenLabs 暴露的鉴权 token(ElevenLabs 工具 Header 里带同样的值)
# INBOUND_TOKEN=minitable-demo-token-12345

# 可选:服务端口(默认 3000)
# PORT=3000
